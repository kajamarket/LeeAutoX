<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow the root homepage to serve your Vite index.html
  RewriteRule ^$ index.html [L]

  # 2. If the request is for an actual Vite asset file (like /assets/index.js, images, css), serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. If it's a deep link (like /about-us/), bypass Vite completely and fetch it from the WordPress subdomain
   # Alternative fallback if Proxy [P] flag fails
  RewriteRule ^(.*)$ leeautox.leeplugshub.com [R=301,L]

</IfModule>
